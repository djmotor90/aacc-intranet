# --- Core ---
APP_BASE_URL=http://localhost:3000                              # used by worker + email links
DATABASE_URL=postgres://aitim:aitim@localhost:5432/aitim_intranet
DATABASE_POOL_MIN=1
DATABASE_POOL_MAX=10
DATABASE_CONNECT_TIMEOUT_MS=15000
DATABASE_IDLE_TIMEOUT_MS=60000
DATABASE_QUERY_TIMEOUT_MS=30000
PGBOSS_POOL_MAX=3
PGBOSS_CONNECT_TIMEOUT_MS=30000

# --- Auth.js ---
# Canonical URL for OAuth callbacks. MUST match the public domain exactly,
# including https://. Behind a reverse proxy (Traefik/Coolify), this prevents
# the OAuth redirect_uri from being built from internal container hostnames.
AUTH_URL=http://localhost:3000
AUTH_SECRET= # openssl rand -base64 32
AUTH_TRUST_HOST=true
# Explicitly enables password-based local accounts, including in production.
# Leave false when Microsoft Entra ID is the only allowed sign-in method.
AUTH_LOCAL_CREDENTIALS=false
# Development-only shortcut for local credentials.
DEV_AUTH=false

# --- Entra ID: web app registration (interactive SSO, delegated perms) ---
AUTH_MICROSOFT_ENTRA_ID_ID=
AUTH_MICROSOFT_ENTRA_ID_SECRET=
AUTH_MICROSOFT_ENTRA_ID_ISSUER= # https://login.microsoftonline.com/<tenant-id>/v2.0
ENTRA_TENANT_ID=

# --- Entra ID: daemon app registration (worker, application perms) ---
DAEMON_CLIENT_ID=
DAEMON_CLIENT_SECRET=

# --- Email ---
MAIL_TRANSPORT=smtp # smtp (dev: mailpit) | graph (prod)
SMTP_HOST=localhost
SMTP_PORT=1025
# Optional: used in notification email links
# APP_BASE_URL=https://intranet.example.com
# Graph sendMail (when MAIL_TRANSPORT=graph):
# GRAPH_SENDER_UPN=noreply@example.com
GRAPH_SENDER_UPN= # e.g. aacc-hub@example.edu

# --- Storage (S3-compatible: iDrive e2, MinIO, AWS S3, etc.) ---
S3_ENDPOINT=https://s3.us-west-1.idrivee2.com  # remove for AWS S3
S3_REGION=us-west-1
S3_ACCESS_KEY=
S3_SECRET_KEY=
S3_BUCKET_ATTACHMENTS=aacc-hub-attachments
S3_BUCKET_PHOTOS=aacc-hub-photos
S3_FORCE_PATH_STYLE=false  # true only for local MinIO

# --- Public forms ---
TURNSTILE_SITE_KEY=1x00000000000000000000AA # Cloudflare test key (always passes)
TURNSTILE_SECRET_KEY=1x0000000000000000000000000000000AA

# --- Secrets vault (AES-256-GCM) ---
# No key rotation: losing or changing this makes existing secrets unreadable.
SECRETS_ENCRYPTION_KEY= # openssl rand -base64 32
