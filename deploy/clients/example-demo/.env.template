# =============================================================================
# AITIM Intranet — client environment template
# Rendered by: node scripts/render-client-env.mjs deploy/clients/<clientId>
# Placeholders come from client.json + generated secrets (see script).
# NEVER commit a filled .env with real secrets.
# =============================================================================

# --- Core ---
APP_BASE_URL=https://{{PRIMARY_DOMAIN}}
DATABASE_URL={{DATABASE_URL}}

# --- Auth.js ---
AUTH_URL=https://{{PRIMARY_DOMAIN}}
AUTH_SECRET={{AUTH_SECRET}}
AUTH_TRUST_HOST=true

# --- Entra ID: web app (interactive SSO) ---
AUTH_MICROSOFT_ENTRA_ID_ID={{ENTRA_WEB_CLIENT_ID}}
AUTH_MICROSOFT_ENTRA_ID_SECRET={{ENTRA_WEB_CLIENT_SECRET}}
AUTH_MICROSOFT_ENTRA_ID_ISSUER=https://login.microsoftonline.com/{{ENTRA_TENANT_ID}}/v2.0
ENTRA_TENANT_ID={{ENTRA_TENANT_ID}}

# --- Entra ID: daemon app (worker) ---
DAEMON_CLIENT_ID={{ENTRA_DAEMON_CLIENT_ID}}
DAEMON_CLIENT_SECRET={{ENTRA_DAEMON_CLIENT_SECRET}}

# --- Email ---
MAIL_TRANSPORT={{MAIL_TRANSPORT}}
SMTP_HOST={{SMTP_HOST}}
SMTP_PORT={{SMTP_PORT}}
GRAPH_SENDER_UPN={{GRAPH_SENDER_UPN}}

# --- Storage (S3-compatible) ---
S3_ENDPOINT={{S3_ENDPOINT}}
S3_REGION={{S3_REGION}}
S3_ACCESS_KEY={{S3_ACCESS_KEY}}
S3_SECRET_KEY={{S3_SECRET_KEY}}
S3_BUCKET_ATTACHMENTS={{S3_BUCKET_ATTACHMENTS}}
S3_BUCKET_PHOTOS={{S3_BUCKET_PHOTOS}}
S3_FORCE_PATH_STYLE={{S3_FORCE_PATH_STYLE}}

# --- Public forms ---
TURNSTILE_SITE_KEY={{TURNSTILE_SITE_KEY}}
TURNSTILE_SECRET_KEY={{TURNSTILE_SECRET_KEY}}

# --- Secrets vault ---
SECRETS_ENCRYPTION_KEY={{SECRETS_ENCRYPTION_KEY}}

# --- Docs live multiplayer (optional) ---
# Set to "off" to disable client collab attempts.
NEXT_PUBLIC_COLLAB_URL={{COLLAB_PUBLIC_WS_URL}}
COLLAB_PORT={{COLLAB_PORT}}
COLLAB_TOKEN_SECRET={{COLLAB_TOKEN_SECRET}}

# --- Baseline seed (used only by pnpm db:seed:baseline) ---
CLIENT_ADMIN_EMAIL={{CLIENT_ADMIN_EMAIL}}
CLIENT_ADMIN_NAME={{CLIENT_ADMIN_NAME}}
CLIENT_DISPLAY_NAME={{CLIENT_DISPLAY_NAME}}
